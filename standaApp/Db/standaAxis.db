# Extra per-axis records for a Standa 8SMC1-USBhF axis
# Macros: P, M (motor record name), PORT, ADDR

record(ai, "$(P)$(M):Temperature") {
    field(DESC, "Driver temperature")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR))USMC_TEMPERATURE")
    field(SCAN, "I/O Intr")
    field(EGU,  "C")
    field(PREC, "1")
    field(HIGH, "60")
    field(HSV,  "MINOR")
    field(HIHI, "70")
    field(HHSV, "MAJOR")
}

record(ai, "$(P)$(M):Voltage") {
    field(DESC, "Power supply voltage")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR))USMC_VOLTAGE")
    field(SCAN, "I/O Intr")
    field(EGU,  "V")
    field(PREC, "1")
}

record(stringin, "$(P)$(M):Serial") {
    field(DESC, "Controller serial number")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR))USMC_SERIAL")
    field(PINI, "YES")
}

record(bi, "$(P)$(M):Connected") {
    field(DESC, "USB device connected")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR))USMC_CONNECTED")
    field(SCAN, "I/O Intr")
    field(ZNAM, "Disconnected")
    field(ONAM, "Connected")
    field(ZSV,  "MAJOR")
}
